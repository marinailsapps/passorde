# Production .env for /srv/passorde/.env (docs/RUNBOOK.md "Production .env").
# Read by Docker Compose (interpolation in compose.prod.yml) and mounted into
# the app, queue and scheduler containers as Laravel's .env. Never commit the
# real file. Generate secrets with `openssl rand -hex 32`: hex values never
# contain "$", which Compose would try to interpolate.

# --- Docker Compose -----------------------------------------------------------
# So that plain `docker compose …` in /srv/passorde uses the production file.
COMPOSE_FILE=compose.prod.yml
COMPOSE_PROJECT_NAME=passorde
# Image tag running now (short git SHA). Managed by deploy/deploy.sh and
# deploy/rollback.sh: do not edit by hand.
PASSORDE_TAG=latest
# The public host name Caddy serves and certifies (docker/caddy/Caddyfile), e.g. orders.example.com.
APP_DOMAIN=
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=

# --- Application --------------------------------------------------------------
APP_NAME=Passorde
APP_ENV=production
# php artisan key:generate --show (once; changing it signs everyone out)
APP_KEY=
APP_DEBUG=false
APP_URL=https://orders.example.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logs: one file per day in the storage volume (14 days) and the container log.
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Caddy's network in compose.prod.yml ("edge"): real client IPs and https.
# EDGE_SUBNET (default 172.30.93.0/24) is that network's subnet: change both together, only when
# another stack on the host already uses it (docs/RUNBOOK.md "A second installation on the same host").
EDGE_SUBNET=172.30.93.0/24
TRUSTED_PROXIES=172.30.93.0/24

# --- Database (postgres container, internal network only) ---------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=passorde
DB_USERNAME=passorde
# Required, long and random (openssl rand -hex 24)
DB_PASSWORD=

# --- Sessions, cache, queue ---------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

# --- Mail (password reset, daily digest) --------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- First admin (remove ADMIN_PASSWORD once the admin changed it) ------------
ADMIN_LOGIN=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Cloudflare Turnstile on login and password reset -------------------------
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Installation profile (config/passorde.php, docs/RUNBOOK.md "Installation profile") -------------------------
# Required in production: the app refuses to boot while it is empty. The mounted directory (compose.prod.yml), or
# none for the neutral defaults. The categories, texts and Evoliz defaults of the installation come from it.
PASSORDE_PROFILE=/var/www/html/profile
# The host directory holding profile.php, mounted read-only on app, queue and scheduler (default ./profile).
PASSORDE_PROFILE_DIR=

# --- Evoliz -------------------------------------------------------------------
# Scheduled catalogue, stock and client syncs, while Evoliz is active. Empty: on (APP_ENV=production); false stops them.
SYNC_SCHEDULE_ENABLED=
# The one switch for the Evoliz add-on: false (or empty) runs the app on its own. true sends approved orders to Evoliz
# as delivery notes, with the keys below and a licence key pasted on "Réglages Evoliz"; nothing else switches it on.
# Anything other than true or false stops the app with an error.
EVOLIZ_ENABLED=false
PASSORDE_EVOLIZ_BASE_URL=https://www.evoliz.io
PASSORDE_EVOLIZ_COMPANY_ID=
# The API keys of the Evoliz account the delivery notes go to.
PASSORDE_EVOLIZ_PUBLIC_KEY=
PASSORDE_EVOLIZ_SECRET_KEY=
# Test mode: no Evoliz write until true (docs/RUNBOOK.md "Turning Evoliz writes on").
PASSORDE_WRITES_ENABLED=false
# Passorde Connect (config/passorde-connect.php). The licence key is pasted on "Réglages Evoliz" (kept in the
# database, encrypted, so in the backups). Only without it: a one-line key file on the shared storage volume.
PASSORDE_LICENCE_PATH=/var/www/html/storage/passorde/licence.key
# The licence page (/passorde/licence): admins only.
PASSORDE_ROUTE_MIDDLEWARE=web,auth,admin
# Always false: the app runs its own schedule (SYNC_SCHEDULE_ENABLED, routes/console.php).
PASSORDE_SCHEDULE_ENABLED=false
# Token and write locks; empty: CACHE_STORE (shared by app, queue and scheduler).
PASSORDE_CACHE_STORE=

# --- SMS to the client when an order is sent (OVH) ----------------------------
SMS_ENABLED=false
OVH_ENDPOINT=https://eu.api.ovh.com/1.0
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=
OVH_SMS_SERVICE=
# Your validated sender name, once OVH validated it; empty = OVH's short number
OVH_SMS_SENDER=

# --- Operations ---------------------------------------------------------------
# The daily digest goes to the active admins with an email, plus these.
OPS_DIGEST_TO=

# --- Backups: restic on an S3-compatible object storage ------------------------
# The storage's S3 endpoint, e.g. https://s3.example.test; BACKUP_S3_REGION only if the storage asks for one.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
# The restic host and the repository folder in the bucket (deploy/backup.sh, restore.sh).
BACKUP_NAME=passorde
# Encrypts the repository: without it the backups cannot be read. Keep a copy
# outside the server (password manager).
RESTIC_PASSWORD=
