        "globals": "^17.12.0",
        "laravel-vite-plugin": "^2.0.0",
        "playwright": "1.63.0",
        "sharp": "^0.35.5",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^7.0.7",
        "vite-plugin-pwa": "^1.3.0",
