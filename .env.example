APP_NAME=Passorde
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Host ports (see compose.yml). APP_URL follows APP_PORT.
APP_PORT=8093
VITE_PORT=5193
APP_URL=http://localhost:${APP_PORT}
# Tag of the locally built dev image (compose.yml); another one beside another stack.
PASSORDE_DEV_IMAGE=passorde-php:dev
# Linux hosts: your `id -u` / `id -g` when they are not 1000, so the dev container writes files you own (empty: 1000).
USER_ID=
GROUP_ID=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
# Postgres listens on this port in the compose network and on the host.
DB_PORT=54393
DB_DATABASE=passorde
DB_USERNAME=passorde
DB_PASSWORD=secret

# Proxies trusted for X-Forwarded-* (IPs/CIDRs); empty = Docker's 172.16.0.0/12 pool.
TRUSTED_PROXIES=
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=


MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Git SHA of the build (set by CI in production)
APP_VERSION=dev

# First admin, created by `php artisan db:seed` only if no admin exists
ADMIN_LOGIN=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudflare Turnstile on login and password reset forms
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The private installation profile (config/passorde.php: brand, texts, categories, labels), outside the repository.
# PASSORDE_PROFILE_DIR: the host directory compose.yml mounts as profile/ (default ./profile, gitignored).
# PASSORDE_PROFILE: the directory the app reads; empty: profile/; none: no profile (the neutral defaults).
PASSORDE_PROFILE_DIR=
PASSORDE_PROFILE=

# Run the Evoliz sync schedule (scheduler container), only while Evoliz is active. Empty: on with APP_ENV=production,
# off anywhere else, so a laptop whose keys point at a real Evoliz account never syncs by itself. true/false overrides.
# Manual sync buttons and evoliz:sync-* commands work either way.
SYNC_SCHEDULE_ENABLED=false

# The Evoliz add-on (Passorde Connect): true or false; empty means false. Off, the app runs on its own: catalogue and
# clients from CSV, approved orders exported. Only true switches Evoliz on: the keys and the licence key are then
# entered on the admin page "Réglages Evoliz" (docs/RUNBOOK.md "EVOLIZ_ENABLED").
EVOLIZ_ENABLED=

PASSORDE_EVOLIZ_BASE_URL=https://www.evoliz.io
PASSORDE_EVOLIZ_COMPANY_ID=
PASSORDE_EVOLIZ_PUBLIC_KEY=
PASSORDE_EVOLIZ_SECRET_KEY=
# Test mode: false refuses every Evoliz write (no BL, no client). Set it to true once your tests are done (docs/RUNBOOK.md "Turning Evoliz writes on").
PASSORDE_WRITES_ENABLED=false
# Overrides the profile's evoliz.payterm_id (config/passorde.php); only the Evoliz mock needs it (37).
EVOLIZ_PAYTERM_ID=
# Passorde Connect (config/passorde-connect.php). The licence key is entered on "Réglages Evoliz" (database, encrypted);
# until then this one-line key file is read; empty: storage/passorde/licence.key.
PASSORDE_LICENCE_PATH=
# Empty: the licence service itself. Set only to point the refresh at a test service.
PASSORDE_LICENCE_REFRESH_URL=
# The licence page (/passorde/licence): admins only.
PASSORDE_ROUTE_MIDDLEWARE=web,auth,admin
# Always false: the app runs its own schedule (SYNC_SCHEDULE_ENABLED, routes/console.php).
PASSORDE_SCHEDULE_ENABLED=false
# Token and write locks; empty: CACHE_STORE (shared by app, queue and scheduler).
PASSORDE_CACHE_STORE=

# SMS to the client when an order is sent (OVH, tools/ovh-sms-test.sh). Off by default.
SMS_ENABLED=false
# Dev walkthroughs: http://ovh-mock:8080/ovh/1.0 (the mock prints the SMS instead of sending it)
OVH_ENDPOINT=https://eu.api.ovh.com/1.0
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=
OVH_SMS_SERVICE=
# Sender name validated by OVH (e.g. the brand in capitals); empty = OVH's short number
OVH_SMS_SENDER=

# ops:daily-digest goes to the active admins with an email, plus these (comma-separated)
OPS_DIGEST_TO=
