<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="ARGON_MEMORY" value="1024"/>
        <env name="ARGON_TIME" value="1"/>
        <env name="APP_LOCALE" value="fr"/>
        <env name="TURNSTILE_ENABLED" value="false"/>
        <!-- CI has no Evoliz keys: without this the suite would fall into file mode. tests/Feature/FileMode switches it. -->
        <env name="EVOLIZ_ENABLED" value="true"/>
        <!-- Push tests run against Http::fake; the test-mode tests switch it off themselves. -->
        <env name="PASSORDE_WRITES_ENABLED" value="true"/>
        <!-- the app schedules its own syncs; tests/TestCase.php installs a signed test licence. -->
        <env name="PASSORDE_SCHEDULE_ENABLED" value="false"/>
        <!-- The neutral defaults of config/passorde.php; a run with -e PASSORDE_PROFILE=… checks another profile. -->
        <env name="PASSORDE_PROFILE" value="none"/>
        <env name="SESSION_ENCRYPT" value="false"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <!-- tests/TestCase.php refuses any other database before RefreshDatabase empties it. -->
        <env name="DB_DATABASE" value="passorde_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
